--game logic--------------------------------------------------------------------

--gm is Game Manager--
function gm_init()
	score=0
	difficulty=1
	timers={}

	bw=8 --block width--
	bh=8 --block height
	blocks={}
	for i=1,5 do
		add(blocks, spawn_block(flr(rnd(16))*8,i*8))
		--flr(rnd(15))
	end
end


function gm_update()
	for b in all(blocks) do
		b:update()
	end
end


function gm_draw()
	for b in all(blocks) do
		b:draw()
	end
end



function call_function_every_x_seconds(seconds,func_to_call)
	return{
	time_left=seconds*60,
	update=function(self)
		self.time_left-=1
		if self.time_left<=0 then
			func_to_call()
			--self.time_left=self.start_time
			self.time_left=seconds*60
		end
	end
	}
end

function call_function_every_x_seconds(seconds,func_to_call,value)
	return{
	time_left=seconds*60,
	update=function(self)
		self.time_left-=1
		if self.time_left<=0 then
			func_to_call(value)
			--self.time_left=self.start_time
			self.time_left=seconds*60
		end
	end
	}
end



