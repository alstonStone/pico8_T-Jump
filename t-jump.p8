__lua__
--main--

function _init()
	debug=false
	gravity=5
	--p_init()
	plr_init()
	bm_init()
end


function _update()
--p_update()
	plr_update()
	bm_update()
end


function _draw()
	cls()
	map()
--	p_draw()
	plr_draw()
	bm_draw()
end
-->8
--player--

function p_init()
	px=63
	py=63
	is_grounded=false
	gravity=5
	p_speed=3
	jump=0
	jump_str=10
end


function p_update()
	if (py>=120) py=120 is_grounded=true
	if (not is_grounded) py+=gravity
	
	move_lr()

	--jump logic--
	if is_grounded and (btn(❎)) then
		jump=jump_str
		is_grounded=false
	end
	py-=jump
	if (jump>0) jump-=1
	--end jump logic
	
	
	
end


function p_draw()
	spr(1,px,py)
	print(is_grounded)
end

function move_lr()--move left right--
	if (btn(⬅️)) px-=p_speed
	if (btn(➡️)) px+=p_speed
end

