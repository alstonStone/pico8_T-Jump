pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main--

function _init()
	p_init()
end


function _update()
	p_update()
end


function _draw()
	cls()
	map()
	p_draw()
end
-->8
--player--

function p_init()
	px=63
	py=63
	is_grounded=false
	gravity=5
	p_speed=1
	jump=0
	jump_str=10
end


function p_update()
	if (py>=120) py=120 is_grounded=true
	if (not is_grounded) py+=gravity
	
	if (btn(⬅️)) px-=p_speed
	if (btn(➡️)) px+=p_speed
	--jump logic--
	if is_grounded and (btn(❎)) then
		jump=jump_str
		is_grounded=false
	end
	py-=jump
	if (jump>0) jump-=1
	--end jump logic
	
	
	
end


function p_draw()
	spr(1,px,py)
	print(is_grounded)
end
